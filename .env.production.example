# Copy to .env on the VPS (next to docker-compose.yml). Never commit the filled-in file.
DOMAIN=orbit.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-value
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# Optional: Sign in with Google (docs/GOOGLE_SIGN_IN.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=
# Optional: Google Form link for the in-app Beta feedback button
FEEDBACK_URL=
# Demo instance only: shows demo accounts on the sign-in page and permits seeding fictional data.
DEMO_MODE=false
ALLOW_DEMO_SEED=false
