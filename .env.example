# Public base URL of the app (used for links in exports/notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (server only)
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit_dev

# Directory for private uploaded files (compliance documents, evidence photos).
# Must NOT be publicly served. Files are only served via permission-checked routes.
STORAGE_DIR=./storage

# AI provider. Leave AI_API_KEY empty to run the Copilot in labelled deterministic demo mode.
# Supported: anthropic
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Session cookies are Secure (HTTPS-only) when NODE_ENV=production. Set to "false" ONLY to try a
# production build over plain HTTP on localhost. Never disable on a public server.
# COOKIE_SECURE=

# Set to "true" only on a private demo instance to show demo account hints on the sign-in page.
DEMO_MODE=true

# Optional: "Continue with Google" sign-in (see docs/GOOGLE_SIGN_IN.md). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow Google accounts from these domains (comma-separated), e.g. yourcompany.com
GOOGLE_ALLOWED_DOMAINS=
# Public base URL used for the Google callback (server-side). Auto-detected on Render.
APP_URL=http://localhost:3000

# Optional: link shown as "Beta feedback" in the header (e.g. a Google Form URL).
FEEDBACK_URL=

# Hosted test instances only (scripts/start-hosted.sh): load fictional demo data on start if missing.
SEED_DEMO_DATA=false
